{
  "name": "nivlo",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "tauri": "node apps/desktop/ui/node_modules/@tauri-apps/cli/tauri.js",
    "dev:ui": "pnpm --filter @nivlo/desktop-ui dev",
    "build:ui": "pnpm --filter @nivlo/desktop-ui build",
    "lint": "pnpm --filter @nivlo/desktop-ui lint",
    "format": "pnpm --filter @nivlo/desktop-ui format",
    "format:check": "pnpm --filter @nivlo/desktop-ui format:check",
    "typecheck": "pnpm --filter @nivlo/desktop-ui typecheck",
    "test": "pnpm --filter @nivlo/desktop-ui test",
    "gen:bindings": "cargo run -p nivlo-desktop --example gen_bindings",
    "visual": "node scripts/visual/visual.mjs",
    "visual:update": "node scripts/visual/visual.mjs --update"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
