{
  "name": "asterjot",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "tauri": "node apps/desktop/ui/node_modules/@tauri-apps/cli/tauri.js",
    "dev:ui": "pnpm --filter @asterjot/desktop-ui dev",
    "build:ui": "pnpm --filter @asterjot/desktop-ui build",
    "lint": "pnpm --filter @asterjot/desktop-ui lint",
    "format": "pnpm --filter @asterjot/desktop-ui format",
    "format:check": "pnpm --filter @asterjot/desktop-ui format:check",
    "typecheck": "pnpm --filter @asterjot/desktop-ui typecheck",
    "test": "pnpm --filter @asterjot/desktop-ui test",
    "check:ui": "npm --prefix apps/desktop/ui run check",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -j 2 -- -D warnings && cargo test --workspace -j 2 && node scripts/check-clock-usage.mjs && node scripts/check-deps/check-deps.mjs && node scripts/check-doc-links/check-doc-links.mjs",
    "check": "npm run check:ui && npm run check:rust",
    "gen:bindings": "cargo run -p asterjot-desktop --example gen_bindings",
    "e2e": "node tests/e2e/e2e.mjs",
    "visual": "node scripts/visual/visual.mjs",
    "visual:update": "node scripts/visual/visual.mjs --update"
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
