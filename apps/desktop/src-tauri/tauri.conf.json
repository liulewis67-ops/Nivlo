{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nivlo",
  "version": "0.1.0",
  "identifier": "app.nivlo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nivlo/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @nivlo/desktop-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Nivlo", "width": 960, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
