{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nivlo",
  "version": "0.1.0",
  "identifier": "app.nivlo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nivlo/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @nivlo/desktop-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Nivlo",
    "shortDescription": "Nivlo — 悬浮窗 + 收集箱 + 待办",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QTg3MEYzM0U1QkUyNjMKUldSajRscys4M0NvNWNEK2FKSllYM2VidmJFK05yM1VBcVVvMzRZUzhJL2FXSWNnUmExVmtobksK",
      "endpoints": [
        "https://REPLACE-WITH-YOUR-UPDATE-HOST/nivlo/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
