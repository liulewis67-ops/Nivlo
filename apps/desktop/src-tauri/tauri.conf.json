{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarDeskBox",
  "version": "0.1.4",
  "identifier": "app.stardeskbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @stardeskbox/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @stardeskbox/desktop-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "StarDeskBox",
    "shortDescription": "StarDeskBox — 悬浮窗 + 收集箱 + 待办",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QTg3MEYzM0U1QkUyNjMKUldSajRscys4M0NvNWNEK2FKSllYM2VidmJFK05yM1VBcVVvMzRZUzhJL2FXSWNnUmExVmtobksK",
      "endpoints": [
        "https://github.com/liulewis67-ops/StarDeskBox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
