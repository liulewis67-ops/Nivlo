{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "search-window",
  "description": "全局搜索框的最小权限：只能搜索、列出最近的条目、项目名称与标签、用 Quick Create 记下待办、完成选中的待办（Ctrl+D）及其撤销、把结果交给主窗口打开、在主窗口打开某个视图（「>」命令）、隐藏自己，并监听事件（架构文档 §13）。",
  "windows": ["search"],
  "permissions": [
    "core:event:default",
    "allow-search-items",
    "allow-list-items",
    "allow-list-projects",
    "allow-tags-for-items",
    "allow-quick-create",
    "allow-complete-item",
    "allow-reopen-item",
    "allow-open-item-in-main",
    "allow-open-main-at",
    "allow-hide-search"
  ]
}
