{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "search-window",
  "description": "全局搜索框的最小权限：只能搜索、把结果交给主窗口打开、隐藏自己，并监听事件（架构文档 §13）。",
  "windows": ["search"],
  "permissions": [
    "core:event:default",
    "allow-search-items",
    "allow-open-item-in-main",
    "allow-hide-search"
  ]
}
