{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "主窗口的权限：完整的 Item 管理命令、打开 / 退出应用，并可监听事件。",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-create-item",
    "allow-get-item",
    "allow-list-items",
    "allow-get-today",
    "allow-reorder-today",
    "allow-quick-create",
    "allow-capture",
    "allow-undo-capture",
    "allow-take-pending-main-view",
    "allow-get-shortcut-status",
    "allow-set-quick-create-shortcut",
    "allow-list-inbox",
    "allow-get-inbox-count",
    "allow-organize-items",
    "allow-restore-items",
    "allow-complete-item",
    "allow-reopen-item",
    "allow-reschedule-item",
    "allow-open-main",
    "allow-quit-app"
  ]
}
