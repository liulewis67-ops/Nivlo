    "allow-undo-capture",
    "allow-capture-from-clipboard",
    "allow-read-clipboard-text",
    "allow-take-pending-main-view",
    "allow-get-shortcut-status",
    "allow-set-shortcut",
    "allow-suggest-shortcuts",
    "allow-disable-shortcut",
    "allow-list-inbox",
    "allow-get-inbox-count",
    "allow-organize-items",
    "allow-restore-items",
    "allow-complete-item",
    "allow-reopen-item",
