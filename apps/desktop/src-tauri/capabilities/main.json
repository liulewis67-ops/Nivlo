    "allow-get-app-settings",
    "allow-list-integrations",
    "allow-connect-integration",
    "allow-disconnect-integration",
    "allow-test-integration",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-ui-pref",
    "allow-set-ui-pref",
    "allow-set-autostart",
    "allow-set-floating-always-on-top",
    "allow-set-search-prewarm",
    "allow-set-later-rule",
    "allow-get-calendar",
    "allow-set-week-start",
