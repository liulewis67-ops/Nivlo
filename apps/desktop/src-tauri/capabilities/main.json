    "allow-create-item",
    "allow-undo-created-item",
    "allow-get-item",
    "allow-list-items",
    "allow-search-items",
    "allow-mark-item-opened",
    "allow-get-item-detail",
    "allow-update-item",
    "allow-open-item-source",
    "allow-delete-items",
    "allow-restore-deleted-items",
    "allow-list-trash",
    "allow-purge-items",
    "allow-empty-trash",
    "allow-export-diagnostics",
    "allow-create-backup-file",
    "allow-export-data",
    "allow-restore-backup",
    "allow-reset-all-data",
    "allow-restart-app",
    "allow-list-workflows",
    "allow-set-workflow-enabled",
