{
  "db_name": "SQLite",
  "query": "SELECT id, type AS item_type, title, content, content_format, status, priority,\n                    scheduled_date, scheduled_time, due_date, due_time, reminder_at,\n                    project_id, in_inbox, created_at, updated_at, completed_at, archived_at\n             FROM items\n             WHERE (?1 IS NULL OR type = ?1)\n               AND (?2 = 1 OR archived_at IS NULL)\n               AND (?3 = 0 OR in_inbox = 1)\n             ORDER BY CASE WHEN ?4 = 1 THEN updated_at ELSE created_at END DESC, id DESC\n             LIMIT ?5",
