{
  "schemaVersion": 1,
  "id": "builtin.file-document",
  "name": "文档（Markdown / PDF / Office 等）",
  "description": "拖入的文档（可以一次多个）每个变成一条笔记，标题优先用文档自己的标题：Markdown 的首个标题，PDF、Word、PowerPoint、Excel、OpenDocument、EPUB 的标题属性，HTML 文件的网页标题；读不到就用文件名，一起拖入的其他文件按文件名建笔记。只保存文件的引用，不复制文件；取标题时只读文件里很小的一部分，大文件也不会拖慢。",
  "version": 2,
  "priority": 5,
  "enabled": true,
  "source": "builtin",
  "matcher": {
    "all": [
      {
        "any": [
          { "field": "input.type", "op": "equals", "value": "file" },
          { "field": "input.type", "op": "equals", "value": "files" }
        ]
      },
      {
        "any": [
          { "field": "file.extension", "op": "equals", "value": "md" },
          { "field": "file.extension", "op": "equals", "value": "markdown" },
          { "field": "file.extension", "op": "equals", "value": "pdf" },
          { "field": "file.extension", "op": "equals", "value": "docx" },
          { "field": "file.extension", "op": "equals", "value": "pptx" },
          { "field": "file.extension", "op": "equals", "value": "xlsx" },
          { "field": "file.extension", "op": "equals", "value": "odt" },
          { "field": "file.extension", "op": "equals", "value": "ods" },
          { "field": "file.extension", "op": "equals", "value": "odp" },
          { "field": "file.extension", "op": "equals", "value": "epub" },
          { "field": "file.extension", "op": "equals", "value": "html" },
          { "field": "file.extension", "op": "equals", "value": "htm" }
        ]
      }
    ]
  },
  "steps": [
    { "type": "readFile", "into": "doc", "optional": true },
    {
      "type": "createItem",
      "itemType": "note",
      "title": "{{ vars.doc_title | default(file.name) | truncate(120) }}",
      "inInbox": true,
      "forEach": "files"
    }
  ]
}
