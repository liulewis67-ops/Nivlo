{
  "schemaVersion": 1,
  "id": "builtin.web-page",
  "name": "网页（补全标题和摘要）",
  "description": "网址先立刻变成笔记，随后在后台读取网页的标题和摘要补全进去。读取失败或没有网络时，笔记保持「域名/路径」标题，不受影响。",
  "version": 2,
  "priority": 1,
  "enabled": true,
  "source": "builtin",
  "matcher": { "field": "input.type", "op": "equals", "value": "url" },
  "permissions": { "network": true, "hosts": ["*"] },
  "steps": [
    { "type": "http", "url": "{{ input.url }}", "into": "page", "optional": true, "maxBytes": 524288 },
    { "type": "htmlMeta", "from": "vars.page", "into": "meta", "optional": true },
    {
      "type": "transform",
      "set": { "summary": "{{ vars.meta_description | default(\"\") | truncate(300) }}" }
    },
    {
      "type": "createItem",
      "itemType": "note",
      "title": "{{ vars.meta_title | default(input.title) | truncate(120) }}",
      "content": "{{ input.url }}\n\n{{ vars.summary }}",
      "inInbox": true
    }
  ]
}
